{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":false},"erDesign":{"model":{"uid":175,"erCode":"/* Entities */\nentity VENUE {\n    id (id),\n    name,\n    city,\n    time_zone,\n    owner_id\n}\nentity SECTOR {\n    id (external),\n    name\n}\nentity SEAT {\n    number (external),\n    row (external)\n}\nentity EVENT {\n    id (id),\n    organizer_id,\n    name,\n    sale_start,\n    published_at (optional),\n    currency\n}\nentity SESSION {\n    id (external),\n    starts_at,\n    sale_end,\n    ends_at,\n    version\n}\nentity SESSION_SEAT\nentity PRICE_TIER {\n    id (external),\n    name,\n    price\n}\nentity FREE\nentity HELD {\n    expires_at,\n    customer_id\n}\nentity SOLD\nentity ORDER {\n    id (id),\n    customer_id,\n    ordered_at,\n    idempotency_key,\n    customer_email\n}\nentity PAID {\n    paid_at\n}\nentity PENDING\nentity FAILED {\n    reason,\n    failed_at\n}\nentity CANCELLED {\n    cancelled_at,\n    reason\n}\nentity TICKET {\n    id (id),\n    pdf_key (optional)\n}\nentity SCANNED {\n    gate_staff_id,\n    scanned_at\n}\nentity UNSCANNED\nentity PSP_OPERATION {\n    id (id),\n    status,\n    created_at,\n    currency,\n    amount,\n    failure_reason (optional)\n}\nentity PAYPAL_PAYMENT {\n    paypal_capture_id (optional),\n    paypal_order_id (optional)\n}\nentity PAYPAL_REFUND {\n    paypal_refund_id (optional)\n}\nentity PAYMENT {\n    expires_at,\n    payer_action_url (optional)\n}\nentity REFUND\nentity ORDER_ITEM {\n    holder_last_name,\n    holder_first_name\n}\n\n/* Relationships */\nrelationship CONTAINS_SECTORS (\n    VENUE: one..many,\n    SECTOR: one..one external\n)\nrelationship CONTAINS_SEATS (\n    SECTOR: one..many,\n    SEAT: one..one external\n)\nrelationship HOSTS (\n    VENUE: zero..many,\n    EVENT: one..one\n)\nrelationship HAS_SESSIONS (\n    EVENT: zero..many,\n    SESSION: one..one external\n)\nrelationship HAS_SEATS (\n    SESSION: one..many,\n    SESSION_SEAT: one..one external\n)\nrelationship HAS_PRICES (\n    SESSION: one..many,\n    PRICE_TIER: one..one external\n)\nrelationship BELONGS_TO (\n    SESSION_SEAT: one..one,\n    PRICE_TIER: zero..many\n)\nrelationship REFERS_TO (\n    SEAT: zero..many,\n    SESSION_SEAT: one..one external\n)\nrelationship HAS_PAYMENTS (\n    ORDER: zero..many,\n    PSP_OPERATION: one..one\n)\nrelationship IS_PAYPAL_REFUND (\n    REFUND: zero..one,\n    PAYPAL_REFUND: one..one external\n)\nrelationship FOR_SEAT (\n    SESSION_SEAT: zero..many,\n    ORDER_ITEM: one..one external\n)\nrelationship ISSUED_FOR (\n    ORDER_ITEM: zero..one,\n    TICKET: one..one\n)\nrelationship INCLUDES (\n    ORDER_ITEM: one..one external,\n    ORDER: one..many\n)\nrelationship IS_PAYPAL_PAYMENT (\n    PAYMENT: zero..one,\n    PAYPAL_PAYMENT: one..one external\n)\n\n/* Generalizations */\nSESSION_SEAT <= {\n    FREE,\n    HELD,\n    SOLD\n} (total, exclusive)\nORDER <= {\n    PAID,\n    PENDING,\n    FAILED,\n    CANCELLED\n} (total, exclusive)\nTICKET <= {\n    SCANNED,\n    UNSCANNED\n} (total, exclusive)\nPSP_OPERATION <= {\n    PAYMENT,\n    REFUND\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"VENUE","_x":-720,"_y":-653,"_mag":false},{"__type":"Entity","_id":2,"_name":"SECTOR","_x":-45,"_y":-646,"_mag":false},{"__type":"Relationship","_id":3,"_name":"CONTAINS_SECTORS","_x":-371,"_y":-649},{"__type":"Participation","_id":4,"_entityId":1,"_tableId":null,"_relationshipId":3,"_cardinality":"1_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":5,"_entityId":2,"_tableId":null,"_relationshipId":3,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},{"__type":"Entity","_id":6,"_name":"SEAT","_x":897,"_y":-652,"_mag":false},{"__type":"Relationship","_id":7,"_name":"CONTAINS_SEATS","_x":254,"_y":-644},{"__type":"Participation","_id":8,"_entityId":2,"_tableI
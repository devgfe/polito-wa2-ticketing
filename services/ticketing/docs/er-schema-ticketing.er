{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":159,"erCode":"/* Entities */\nentity VENUE {\n    id (id),\n    name,\n    city,\n    time_zone\n}\nentity SECTOR {\n    id (external),\n    name\n}\nentity SEAT {\n    number (external),\n    row (external)\n}\nentity EVENT {\n    id (id),\n    name,\n    currency\n}\nentity SESSION {\n    id (external),\n    starts_at,\n    ends_at\n}\nentity SESSION_SEAT\nentity ORDER {\n    id (id),\n    customer_id,\n    status,\n    customer_email\n}\nentity TICKET {\n    id (id),\n    pdf_key (optional)\n}\nentity SCANNED {\n    gate_staff_id,\n    scanned_at\n}\nentity UNSCANNED\nentity ORDER_ITEM {\n    holder_first_name,\n    holder_last_name\n}\nentity PRICE_TIER {\n    id (external),\n    price\n}\n\n/* Relationships */\nrelationship CONTAINS_SECTORS (\n    VENUE: one..many,\n    SECTOR: one..one external\n)\nrelationship CONTAINS_SEATS (\n    SECTOR: one..many,\n    SEAT: one..one external\n)\nrelationship HOSTS (\n    VENUE: zero..many,\n    EVENT: one..one\n)\nrelationship HAS_SESSIONS (\n    EVENT: zero..many,\n    SESSION: one..one external\n)\nrelationship HAS_SEATS (\n    SESSION: one..many,\n    SESSION_SEAT: one..one external\n)\nrelationship REFERS_TO (\n    SEAT: zero..many,\n    SESSION_SEAT: one..one external\n)\nrelationship ISSUED_FOR (\n    ORDER_ITEM: zero..one,\n    TICKET: one..one\n)\nrelationship INCLUDES (\n    ORDER_ITEM: one..one external,\n    ORDER: one..many\n)\nrelationship FOR_SEAT (\n    SESSION_SEAT: zero..many,\n    ORDER_ITEM: one..one external\n)\nrelationship HAS_PRICES (\n    SESSION: one..many,\n    PRICE_TIER: one..one external\n)\nrelationship BELONGS_TO (\n    PRICE_TIER: zero..many,\n    SESSION_SEAT: one..one\n)\n\n/* Generalizations */\nTICKET <= {\n    SCANNED,\n    UNSCANNED\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entit
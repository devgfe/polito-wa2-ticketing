{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":151,"erCode":"/* Entities */\nentity VENUE {\n    id (id),\n    time_zone\n}\nentity SECTOR {\n    id (external)\n}\nentity SEAT {\n    number (external),\n    row (external)\n}\nentity EVENT {\n    id (id),\n    sale_start,\n    currency,\n    organizer_id\n}\nentity SESSION {\n    id (external),\n    starts_at,\n    sale_end,\n    version\n}\nentity SESSION_SEAT\nentity PRICE_TIER {\n    id (external),\n    price\n}\nentity FREE\nentity HELD {\n    expires_at,\n    customer_id\n}\nentity SOLD\nentity ORDER {\n    id (id),\n    customer_id,\n    ordered_at,\n    idempotency_key,\n    customer_email\n}\nentity PAID {\n    paid_at\n}\nentity PENDING\nentity FAILED {\n    reason,\n    failed_at\n}\nentity CANCELLED {\n    cancelled_at,\n    reason\n}\nentity ORDER_ITEM {\n    holder_first_name,\n    holder_last_name\n}\n\n/* Relationships */\nrelationship CONTAINS_SECTORS (\n    VENUE: one..many,\n    SECTOR: one..one external\n)\nrelationship CONTAINS_SEATS (\n    SECTOR: one..many,\n    SEAT: one..one external\n)\nrelationship HOSTS (\n    VENUE: zero..many,\n    EVENT: one..one\n)\nrelationship HAS_SESSIONS (\n    EVENT: zero..many,\n    SESSION: one..one external\n)\nrelationship HAS_SEATS (\n    SESSION: one..many,\n    SESSION_SEAT: one..one external\n)\nrelationship HAS_PRICES (\n    SESSION: one..many,\n    PRICE_TIER: one..one external\n)\nrelationship BELONGS_TO (\n    SESSION_SEAT: one..one,\n    PRICE_TIER: zero..many\n)\nrelationship REFERS_TO (\n    SEAT: zero..many,\n    SESSION_SEAT: one..one external\n)\nrelationship FOR_SEAT (\n    SESSION_SEAT: zero..many,\n    ORDER_ITEM: one..one external\n)\nrelationship INCLUDES (\n    ORDER_ITEM: one..one external,\n    ORDER: one..many\n)\n\n/* Generalizations */\nSESSION_SEAT <= {\n    FREE,\n    HELD,\n    SOLD\n} (total, exclusive)\nORDER <= {\n    PAID,\n    PENDING,\n    FAILED,\n    CANCELLED\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"VENUE","_x":-720,"_y":-653,"_mag":false},{"__type":"Entity","_id":2,"_name":"SECTOR","_x":-45,"_y":-646,"_mag":false},{"__type":"Relationship","_id":3,"_name":"CONTAINS_SECTORS","_x":-371,"_y":-649},{"__type":"Participation","_id":4,"_entityId":1,"_tableId":null,"_relationshipId":3,"_cardinality":"1_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":5,"_entityId":2,"_tableId":null,"_relationshipId":3,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},{"__type":"Entity","_id":6,"_name":"SEAT","_x":897,"_y":-652,"_mag":false},{"__type":"Relationship","_id":7,"_name":"CONTAINS_SEATS","_x":254,"_y":-644},{"__type":"Participation","_id":8,"_entityId":2,"_tableId":null,"_relationshipId":7,"_cardinality":"1_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":9,"_entityId":6,"_tableId":null,"_relationshipId":7,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},{"__type":"Entity","_id":10,"_name":"EVENT","_x":-743,"_y":-262,"_mag":false},{"__type":"Relationship","_id":11,"_name":"HOSTS","_x":-731,"_y":-451},{"__type":"Participation","_id":12,"_entityId":1,"_tableId":null,"_relationshipId":11,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":13,"_entityId":10,"_tableId":null,"_relationshipId":11,"_cardinality":"1_1","_externalIdentifier":false,"_role":""},{"__type":"Entity","_id":14,"_name":"SESSION","_x":49,"_y":-277,"_mag":false},{"__type":"Entity","_id":15,"_name":"SESSION_SEAT","_x":915,"_y":-278,"_mag":false},{"__type":"Relationship","_id":16,"_name":"HAS_SESSIONS","_x":-376,"_y":-276},{"__type":"Relationship","_id":17,"_name":"HAS_SEATS","_x":450,"_y":-285},{"__type":"Relationship","_id":18,"_name":"HAS_PRICES","_x":50,"_y":-62},{"__type":"Entity","_id":19,"_name":"PRICE_TIER","_x":54,"_y":212,"_mag":fal